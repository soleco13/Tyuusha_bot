# Токен бота от @BotFather
BOT_TOKEN=

# Telegram ID операторов через запятую (свой ID можно узнать командой /myid у бота)
ADMIN_IDS=

# Имя принтера в Windows (список — команда /printers у бота). Пусто = принтер по умолчанию
PRINTER_NAME=EPSON L3250 Series (копия 1)

# printer — печатать на принтер; file — только сохранять листы в data/printed (проверка без бумаги)
PRINT_MODE=printer

# Веб-админка заказов: пароль для входа (обязательно), адрес и порт.
# ADMIN_HOST=0.0.0.0 — открыть панель для других устройств в вашей сети (телефон оператора)
ADMIN_PASSWORD=
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8080

# Печать через компьютер с принтером: на сервере PRINT_MODE=agent и AGENT_TOKEN (любая длинная случайная строка).
# На самом компьютере с принтером (agent\run_agent.bat) укажите SERVER_URL, тот же AGENT_TOKEN и PRINTER_NAME.
# SERVER_URL=https://213.21.241.28
# AGENT_TOKEN=
